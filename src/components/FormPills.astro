---
import type { Outcome } from '../lib/openligadb.ts';

interface Props {
  form: Outcome[];
  /** "dots": kleine Punkte ohne Buchstaben (für enge Stellen am Handy) */
  variant?: 'pills' | 'dots';
}
const { form, variant = 'pills' } = Astro.props;
const label = { S: 'Sieg', U: 'Unentschieden', N: 'Niederlage' } as const;
const cls = { S: 'bg-win text-white', U: 'bg-draw text-white', N: 'bg-loss text-white' } as const;
---

{
  form.length > 0 && (
    <ol class:list={['flex', variant === 'dots' ? 'gap-0.5' : 'gap-1']} aria-label={`Form, ältestes Spiel zuerst: ${form.map((f) => label[f]).join(', ')}`}>
      {form.map((f) => (
        <li
          class:list={[
            'grid place-items-center font-bold',
            variant === 'dots' ? 'size-2 rounded-full' : 'size-6 rounded-md text-[11px]',
            cls[f],
          ]}
          title={label[f]}
          aria-hidden="true"
        >
          {variant === 'pills' && f}
        </li>
      ))}
    </ol>
  )
}
