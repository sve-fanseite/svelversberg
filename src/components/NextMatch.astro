---
import TeamBadge from './TeamBadge.astro';
import SourceNote from './SourceNote.astro';
import { kickoff, shortLabel, type OldbMatch } from '../lib/openligadb.ts';
import type { LeagueInfo, Section } from '../lib/data.ts';
import { formatDateLong, formatTime } from '../lib/time.ts';
import { url } from '../lib/url.ts';

interface Props {
  match: OldbMatch | null;
  teamId: number | null;
  league: LeagueInfo | null;
  section: Section<unknown> | null;
}
const { match, teamId, league, section } = Astro.props;
const ko = match ? kickoff(match) : null;
const isHome = match ? match.team1.teamId === teamId : false;
---

<!-- Das Hero ist in beiden Farbmodi dunkel (Klasse "dark" setzt die dunklen Farben) -->
<section class="dark bg-bg text-ink" aria-labelledby="next-heading">
  <div class="relative mx-auto max-w-6xl overflow-hidden px-4 py-10 sm:py-14">
    <!-- dezente Deko-Linien wie Spielfeldmarkierungen -->
    <svg class="pointer-events-none absolute -right-24 -top-24 size-[28rem] text-accent opacity-[0.07]" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="100" cy="100" r="60"></circle><circle cx="100" cy="100" r="3" fill="currentColor"></circle><path d="M100 0v200"></path>
    </svg>

    {
      match && ko ? (
        <div class="relative">
          <p class="eyebrow reveal">
            <span id="next-heading">Nächstes Spiel</span>
            {league && <> · {league.name}</>}
            {match.group && <> · {match.group.groupName}</>}
          </p>

          <div class="mt-6 grid grid-cols-[1fr_auto_1fr] items-center gap-3 sm:gap-8">
            {[match.team1, match.team2].map((t, i) => (
              <div class:list={['reveal reveal-2 flex flex-col items-center gap-3 text-center', i === 0 ? 'sm:flex-row sm:text-left' : 'sm:flex-row-reverse sm:text-right']}>
                <TeamBadge team={t} highlight={t.teamId === teamId} size="lg" />
                <p class:list={['h-display text-2xl [overflow-wrap:anywhere] sm:text-4xl lg:text-5xl', t.teamId === teamId && 'text-accent-ink']}>
                  <span class="sm:hidden">{shortLabel(t)}</span>
                  <span class="hidden sm:inline">{t.teamName}</span>
                </p>
              </div>
            ))}
            <span class="order-none col-start-2 row-start-1 font-display text-2xl font-bold text-muted sm:text-4xl" aria-label="gegen">
              vs
            </span>
          </div>

          <div class="reveal reveal-3 mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center text-sm sm:text-base">
            <time datetime={ko.toISOString()} class="font-semibold">
              {formatDateLong(ko)} · {formatTime(ko)}
            </time>
            <span class="rounded-full border border-accent/60 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-accent-ink">
              {isHome ? 'Heimspiel' : 'Auswärtsspiel'}
            </span>
          </div>

          <div
            class="reveal reveal-3 mx-auto mt-6 grid max-w-md grid-cols-4 gap-2 text-center"
            data-countdown={ko.toISOString()}
            role="timer"
            aria-label="Countdown bis zum Anpfiff"
          >
            {['Tage', 'Std', 'Min', 'Sek'].map((label) => (
              <div class="rounded-xl border border-line bg-surface py-3">
                <span class="block font-display text-4xl font-bold leading-none text-accent-ink sm:text-5xl" data-part={label}>
                  –
                </span>
                <span class="mt-1 block text-[11px] font-semibold uppercase tracking-wider text-muted">{label}</span>
              </div>
            ))}
          </div>
          <p class="mt-3 hidden text-center text-lg font-semibold text-accent-ink" data-countdown-status></p>

          <div class="reveal reveal-4 mt-8 flex flex-wrap justify-center gap-3">
            <a href={url('/spielplan')} class="btn btn-accent">Zum Spielplan</a>
            <a href={url('/spielplan.ics')} class="btn btn-ghost">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 11h18"></path></svg>
              Spiele in den Kalender
            </a>
          </div>
          {section && (
            <div class="text-center">
              <SourceNote source="OpenLigaDB" asOf={section.asOf} stale={section.stale} />
            </div>
          )}
        </div>
      ) : (
        <div class="relative py-6 text-center">
          <p class="eyebrow" id="next-heading">Nächstes Spiel</p>
          <p class="h-display mt-4 text-4xl sm:text-5xl">Gerade steht kein Spiel an</p>
          <p class="mx-auto mt-3 max-w-md text-muted">
            {section
              ? 'Sobald der nächste Termin feststeht, erscheint er hier mit Countdown.'
              : 'Der Spielplan konnte gerade nicht geladen werden. Beim nächsten automatischen Update versuchen wir es erneut.'}
          </p>
        </div>
      )
    }
  </div>
</section>

<script>
  function pad(n: number) {
    return String(n).padStart(2, '0');
  }
  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const target = new Date(el.dataset.countdown!).getTime();
    const status = el.parentElement?.querySelector<HTMLElement>('[data-countdown-status]');
    const parts = {
      Tage: el.querySelector<HTMLElement>('[data-part="Tage"]'),
      Std: el.querySelector<HTMLElement>('[data-part="Std"]'),
      Min: el.querySelector<HTMLElement>('[data-part="Min"]'),
      Sek: el.querySelector<HTMLElement>('[data-part="Sek"]'),
    };
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        el.hidden = true;
        if (status) {
          status.hidden = false;
          status.classList.remove('hidden');
          status.textContent = diff > -2.5 * 3600_000 ? 'Anpfiff! Das Spiel läuft.' : 'Abgepfiffen – das Ergebnis folgt beim nächsten Update.';
        }
        return false;
      }
      const s = Math.floor(diff / 1000);
      parts.Tage!.textContent = String(Math.floor(s / 86400));
      parts.Std!.textContent = pad(Math.floor((s % 86400) / 3600));
      parts.Min!.textContent = pad(Math.floor((s % 3600) / 60));
      parts.Sek!.textContent = pad(s % 60);
      return true;
    };
    if (tick()) {
      const id = setInterval(() => {
        if (!tick()) clearInterval(id);
      }, 1000);
    }
  }
</script>
