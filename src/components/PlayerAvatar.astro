---
// Neutraler Platzhalter statt Spielerfoto: Silhouette mit Rückennummer.
interface Props {
  nummer: number;
  size?: 'md' | 'lg';
}
const { nummer, size = 'md' } = Astro.props;
---

<div
  class:list={[
    'relative overflow-hidden rounded-xl bg-surface-2',
    size === 'lg' ? 'aspect-[4/5] w-full max-w-72' : 'aspect-[4/5] w-full',
  ]}
  aria-hidden="true"
>
  <span
    class:list={[
      'absolute left-3 top-2 font-display font-bold leading-none text-accent-ink',
      size === 'lg' ? 'text-8xl' : 'text-5xl',
    ]}>{nummer}</span
  >
  <svg class="absolute inset-x-0 bottom-0 mx-auto h-4/5 text-line" viewBox="0 0 100 110" fill="currentColor">
    <circle cx="50" cy="36" r="20"></circle>
    <path d="M10 110c0-26 18-44 40-44s40 18 40 44z"></path>
  </svg>
</div>
