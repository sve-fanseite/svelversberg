---
// News-Karten: nur Überschrift, Datum, eigener Kurztext und Link zur Originalquelle.
import SourceNote from './SourceNote.astro';
import Notice from './Notice.astro';
import type { NewsItem, Section } from '../lib/data.ts';
import { NEWS_FEEDS } from '../config.ts';
import { formatDay } from '../lib/time.ts';

interface Props {
  section: Section<NewsItem[]> | null;
  count: number;
}
const { section, count } = Astro.props;
const items = section?.data.slice(0, count) ?? [];
const feedLabel = (id: string) => NEWS_FEEDS.find((f) => f.id === id)?.label ?? id;
const sources = [...new Set(items.map((i) => i.sourceName))].join(', ');

// Eigener, neutraler Kurztext – es wird kein Artikeltext übernommen.
function teaser(i: NewsItem) {
  const when = i.date ? ` vom ${formatDay(new Date(i.date))}` : '';
  return `Meldung${when} – den vollständigen Beitrag liest du bei ${i.sourceName}.`;
}
---

{
  items.length > 0 ? (
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((i, idx) => (
        <li class:list={['reveal', idx % 3 === 1 && 'reveal-2', idx % 3 === 2 && 'reveal-3']}>
          <a
            href={i.link}
            rel="noopener"
            target="_blank"
            class="card group flex h-full flex-col p-5 no-underline transition-colors hover:border-accent"
          >
            <div class="flex items-center justify-between gap-2 text-xs">
              <span class="font-semibold uppercase tracking-wider text-accent-ink">{feedLabel(i.sourceId)}</span>
              {i.date && (
                <time datetime={i.date} class="text-muted">
                  {formatDay(new Date(i.date))}
                </time>
              )}
            </div>
            <h3 class="mt-3 text-lg font-semibold leading-snug group-hover:underline">{i.title}</h3>
            <p class="mt-2 text-sm text-muted">{teaser(i)}</p>
            <span class="mt-auto pt-4 text-sm font-semibold">
              Weiterlesen <span class="sr-only">(öffnet {i.sourceName} in neuem Tab)</span>
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <Notice title="Keine News verfügbar">Die News-Quellen haben gerade nicht geantwortet. Schau später noch einmal vorbei.</Notice>
  )
}
{section && items.length > 0 && <SourceNote source={sources} asOf={section.asOf} stale={section.stale} />}
