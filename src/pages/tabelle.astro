---
import Base from '../layouts/Base.astro';
import LeagueTable from '../components/LeagueTable.astro';
import Notice from '../components/Notice.astro';
import SourceNote from '../components/SourceNote.astro';
import { getSiteData } from '../lib/data.ts';
import { computeTable } from '../lib/openligadb.ts';
import { TABLE_ZONES } from '../config.ts';

const data = await getSiteData();
const teamId = data.team?.data.teamId ?? null;
const league = data.league?.data ?? null;
const matches = data.matches?.data ?? [];
const zones = league ? (TABLE_ZONES[league.shortcut] ?? []) : [];

const tables = [
  { id: 'gesamt', label: 'Gesamt', mode: 'all' as const, rows: data.table?.data ?? [], section: data.table },
  { id: 'heim', label: 'Heim', mode: 'home' as const, rows: matches.length ? computeTable(matches, 'home') : [], section: data.matches },
  { id: 'auswaerts', label: 'Auswärts', mode: 'away' as const, rows: matches.length ? computeTable(matches, 'away') : [], section: data.matches },
];
const own = data.table?.data.find((r) => r.teamInfoId === teamId);
const title = league ? `Tabelle ${league.name} ${league.seasonLabel}` : 'Tabelle';
---

<Base title={title} description={`Aktuelle Tabelle der ${league?.name ?? 'Liga'} mit der SV 07 Elversberg: Gesamt-, Heim- und Auswärtstabelle, Tordifferenz und Form der letzten fünf Spiele.`}>
  <div class="mx-auto max-w-6xl px-4 pt-10">
    <p class="eyebrow">{league ? `${league.name} · Saison ${league.seasonLabel}` : 'Liga'}</p>
    <h1 class="h-display mt-2 text-5xl sm:text-6xl">Tabelle</h1>
    {
      own && (
        <p class="mt-3 text-lg text-muted">
          Elversberg steht auf <strong class="text-ink">Platz {own.rank}</strong> mit {own.points} {own.points === 1 ? 'Punkt' : 'Punkten'} aus{' '}
          {own.matches} {own.matches === 1 ? 'Spiel' : 'Spielen'}.
        </p>
      )
    }

    <div class="mt-8 flex gap-1 rounded-xl border border-line bg-surface p-1 text-sm font-semibold sm:inline-flex" role="tablist" aria-label="Tabellenart" data-tabs hidden>
      {
        tables.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="flex-1 rounded-lg px-4 py-2 text-muted transition-colors aria-selected:bg-ink aria-selected:text-bg"
          >
            {t.label}
          </button>
        ))
      }
    </div>

    {
      tables.map((t, i) => (
        <section id={`panel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} class="card mt-4 p-4 sm:p-6" data-panel>
          <h2 class="eyebrow mb-4" data-panel-title>
            {t.label === 'Gesamt' ? 'Gesamttabelle' : `${t.label}tabelle`}
          </h2>
          {t.rows.length > 0 ? (
            <LeagueTable
              rows={t.rows}
              teamId={teamId}
              matches={matches}
              mode={t.mode}
              zones={i === 0 ? zones : []}
              caption={`${t.label === 'Gesamt' ? 'Gesamttabelle' : `${t.label}tabelle`} ${league?.name ?? ''}`}
            />
          ) : (
            <Notice />
          )}
          {t.section && (
            <SourceNote
              source={i === 0 ? 'OpenLigaDB' : 'eigene Berechnung aus den Ergebnissen von OpenLigaDB'}
              asOf={t.section.asOf}
              stale={t.section.stale}
            />
          )}
        </section>
      ))
    }

    {
      zones.length > 0 && (
        <p class="mt-4 text-xs text-muted">
          Die Farbmarkierungen zeigen die üblichen Regelplätze. Sie können sich verschieben, zum Beispiel durch den DFB-Pokalsieger oder
          die UEFA-Wertung. Bei Punktgleichheit entscheidet zuerst die Tordifferenz, dann die Zahl der erzielten Tore.
        </p>
      )
    }
  </div>
</Base>

<script>
  // Reiter Gesamt / Heim / Auswärts. Ohne JavaScript werden alle drei Tabellen untereinander gezeigt.
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (tabs) {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    tabs.hidden = false;
    for (const t of document.querySelectorAll<HTMLElement>('[data-panel-title]')) t.classList.add('sr-only');
    const show = (idx: number, focus = false) => {
      buttons.forEach((b, i) => {
        b.setAttribute('aria-selected', String(i === idx));
        b.tabIndex = i === idx ? 0 : -1;
      });
      panels.forEach((p, i) => (p.hidden = i !== idx));
      if (focus) buttons[idx].focus();
      history.replaceState(null, '', idx === 0 ? location.pathname : `#${panels[idx].id.replace('panel-', '')}`);
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => show(i));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show((i + 1) % buttons.length, true);
        if (e.key === 'ArrowLeft') show((i - 1 + buttons.length) % buttons.length, true);
      });
    });
    const fromHash = panels.findIndex((p) => p.id === `panel-${location.hash.slice(1)}`);
    show(fromHash > 0 ? fromHash : 0);
  }
</script>
