---
// Vorübergehende Platzhalter für Seiten, die wir als Nächstes bauen.
// Sobald eine Seite fertig ist, bekommt sie eine eigene Datei und fliegt hier raus.
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.ts';

export function getStaticPaths() {
  const pages = [
    ['news', 'News'],
    ['tabelle', 'Tabelle'],
    ['spielplan', 'Spielplan & Ergebnisse'],
    ['kader', 'Kader'],
    ['statistiken', 'Statistiken'],
    ['verein', 'Verein'],
    ['impressum', 'Impressum'],
    ['datenschutz', 'Datenschutz'],
  ];
  return pages.map(([slug, title]) => ({ params: { slug }, props: { title } }));
}

const { title } = Astro.props;
---

<Base title={title} noindex>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="eyebrow">In Arbeit</p>
    <h1 class="h-display mt-3 text-5xl sm:text-6xl">{title}</h1>
    <p class="mx-auto mt-4 max-w-md text-muted">Diese Seite bauen wir als Nächstes. Bis dahin findest du das Wichtigste auf der Startseite.</p>
    <a href={url('/')} class="btn btn-accent mt-8">Zur Startseite</a>
  </div>
</Base>
