# Einstellungen für den IONOS-Webspace (Apache). Auf der Vorschau (GitHub Pages) wirkungslos.

# Immer HTTPS und ohne "www"
RewriteEngine On
RewriteCond %{SERVER_PORT} !=443 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://svelversberg.com%{REQUEST_URI} [R=301,L]

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# Richtige Dateitypen
AddType text/calendar .ics
AddType application/json .json
AddType font/woff2 .woff2

# Komprimieren
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/calendar application/javascript application/json image/svg+xml application/xml
</IfModule>

# Zwischenspeichern: Dateien in /_astro/ haben eindeutige Namen und ändern sich nie
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|ics|xml|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
